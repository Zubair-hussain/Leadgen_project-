DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=leadgen
POSTGRES_USER=leadgen_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
LEADGEN_SYNC_REQUESTS=True

# JWT (Django SimpleJWT) lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=
APIFY_API_KEY=
GEMINI_API_KEY=

# Outreach (see docs/outreach.md). Sends from thezubairh@gmail.com through the Gmail API (GOOGLE_* below).
OUTREACH_TRANSPORT=gmail
# --- Resend (own domain, best inbox placement). See docs/resend-autopilot-setup.md ---
# OUTREACH_TRANSPORT=resend
# OUTREACH_FROM_EMAIL=hello@zubairhussain.xyz
# OUTREACH_REPLY_TO=zubair@zubairhussain.xyz   # a mailbox you read; IMAP below should watch it
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...             # Resend -> Webhooks, events email.bounced + email.complained
# --- Autopilot: find leads daily and draft emails ---
# OUTREACH_AUTOPILOT_ENABLED=True
# OUTREACH_AUTOPILOT_OWNER=thezubairh@gmail.com  # the account that owns the leads
# OUTREACH_AUTOPILOT_TARGETS=dentists|Austin, TX; plumbers|Leeds, UK; cafes|Sydney, AU
# OUTREACH_AUTOPILOT_PLATFORMS=google-maps
# OUTREACH_AUTOPILOT_DRAFTS_PER_DAY=15
# --- Weekly report (to OUTREACH_NOTIFY_EMAIL), Sunday 18:00 in this timezone ---
# OUTREACH_WEEKLY_REPORT_ENABLED=True
# OUTREACH_REPORT_TIMEZONE=Asia/Karachi
# OUTREACH_REPORT_WEEKDAY=6
# OUTREACH_REPORT_HOUR=18
OUTREACH_FROM_EMAIL=thezubairh@gmail.com
OUTREACH_FROM_NAME=Zubair Hussain
OUTREACH_SENDER_TITLE=Full Stack Developer
OUTREACH_PORTFOLIO_URL=https://zubairhussain.xyz
OUTREACH_SMTP_HOST=smtp.hostinger.com
OUTREACH_SMTP_PORT=465
OUTREACH_SMTP_SSL=True
# The mailbox password you set in hPanel -> Emails (never commit the real value)
OUTREACH_SMTP_PASSWORD=
# IMAP reads replies/bounces (same login as SMTP unless set)
OUTREACH_IMAP_HOST=imap.hostinger.com
OUTREACH_IMAP_PORT=993
OUTREACH_INBOX_SYNC_ENABLED=True
OUTREACH_IMAP_SAVE_SENT=True
OUTREACH_HTML_EMAIL=True
# Only if OUTREACH_TRANSPORT=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Keep True until you've checked a few dry-run sends look right
OUTREACH_DRY_RUN=True
# Send window uses this time zone: set it to where your leads are, e.g. Europe/London
TIME_ZONE=UTC
OUTREACH_DAILY_LIMIT=30
# Warm-up: day 1 sends 5, +2 per day, until OUTREACH_DAILY_LIMIT
OUTREACH_WARMUP_ENABLED=True
OUTREACH_WARMUP_START=5
OUTREACH_WARMUP_STEP=2
# Follow-ups: days after the previous email (3 follow-ups: day 3, day 7, day 14). Stops on any reply.
OUTREACH_FOLLOWUPS_ENABLED=True
OUTREACH_FOLLOWUP_DAYS=3,4,7
OUTREACH_MIN_PLAYBOOK_SCORE=70
OUTREACH_HOURLY_LIMIT=5
OUTREACH_MIN_DELAY_SECONDS=180
OUTREACH_MAX_DELAY_SECONDS=480
OUTREACH_SEND_HOUR_START=9
OUTREACH_SEND_HOUR_END=17
OUTREACH_WEEKDAYS_ONLY=True
OUTREACH_RECONTACT_DAYS=30
OUTREACH_HUMANIZER_STRICT=True
OUTREACH_NOTIFY_ON_DRAFT=True
# Where review emails go (defaults to OUTREACH_FROM_EMAIL)
OUTREACH_NOTIFY_EMAIL=thezubairh@gmail.com
# On the Oracle server, use its public https address so review links work from your phone
OUTREACH_REVIEW_BASE_URL=http://localhost:8000
OUTREACH_REVIEW_LINK_DAYS=7

# Batch review: ONE email + ONE approval for all drafts
OUTREACH_BATCH_REVIEW=True
OUTREACH_BATCH_QUIET_SECONDS=120
OUTREACH_BATCH_MAX=100
# If you don't answer in time, emails that pass EVERY check are sent; anything uncertain is held
OUTREACH_AUTO_SEND_ENABLED=False
OUTREACH_AUTO_SEND_AFTER_HOURS=12
OUTREACH_AUTO_SEND_MIN_CONFIDENCE=0.9
GEMINI_MODEL=gemini-3.8-flash

# SerpAPI business check (personalises drafts, skips closed businesses, gates auto-send)
OUTREACH_RESEARCH_ENABLED=True
OUTREACH_RESEARCH_MAX_AGE_DAYS=3
OUTREACH_RESEARCH_DAILY_MAX=50

# --- Daily volume, regions and directories ---
OUTREACH_DAILY_MIN=10            # each day a random target between MIN and LIMIT is chosen
OUTREACH_DAILY_LIMIT=20
OUTREACH_COMPLIANCE_ENABLED=True
OUTREACH_REQUIRE_REGION=True     # unknown-country leads are not emailed
OUTREACH_BLOCKED_COUNTRIES=DE,AT # B2B cold email needs prior consent there
OUTREACH_SENDER_ADDRESS=         # REQUIRED to go live: your postal address, printed in every email
OUTREACH_PRIVACY_URL=https://zubairhussain.xyz/privacy
YELP_API_KEY=                    # https://docs.developer.yelp.com/ (free Fusion API key)
DIRECTORY_MAX_PER_RUN=15         # businesses looked up per directory per run (1 SerpAPI search each)

# --- Production hardening ---
ADMIN_URL=change-me-long-random-string/   # the Django admin is only reachable here

# --- Gmail ---
# Sending uses the Gmail API (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN).
# Reading replies (needed for follow-ups) uses IMAP with a Google APP PASSWORD (Google Account -> Security -> App passwords).
# Until you have one, leave both of these False.
OUTREACH_INBOX_SYNC_ENABLED=False
OUTREACH_FOLLOWUPS_ENABLED=False
# OUTREACH_IMAP_HOST=imap.gmail.com
# OUTREACH_IMAP_PASSWORD=
# OUTREACH_IMAP_SENT_FOLDER=[Gmail]/Sent Mail

# --- Vercel (backend project, Root Directory = backend) ---
# Free Postgres: https://neon.tech -> create project -> copy the POOLED connection string.
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# CRON_SECRET=<long random string; same value goes in the GitHub secret CRON_SECRET>
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app
# USE_X_FORWARDED_PROTO=True
# OUTREACH_REVIEW_BASE_URL=https://your-backend.vercel.app
# DIRECTORY_MAX_PER_RUN=8          # keep a lead-generation run under Vercel's 60 second limit
